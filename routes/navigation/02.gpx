  <wpt lat="48.8636" lon="2.35313">
    <name>Fachada de Flamel, 51 rue de Montmorency</name>
    <desc>Pin en calle; no entrar al restaurante.</desc>
  </wpt>
  <wpt lat="48.85318" lon="2.34875">
    <name>Parvis, frente a fachada occidental</name>
    <desc>Desde el espacio público, mirar Sainte-Anne a la derecha al enfrentar la fachada; ajustar posición a barreras/colas sin entrar al edificio.</desc>
  </wpt>
  <wpt lat="48.84009" lon="2.34983">
    <name>Saint-Médard, frente de Mouffetard/Daubenton</name>
    <desc />
  </wpt>
  <wpt lat="48.8399" lon="2.35115">
    <name>Saint-Médard, vista oriental desde rue Censier</name>
    <desc>Pavimento exterior frente al ábside; no supuesto sepulcro ni puerta histórica.</desc>
  </wpt>
